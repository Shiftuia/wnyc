# Copy to .env next to compose.yaml, then: chmod 600 .env   (.env is gitignored and excluded from the image)
# The whole file is passed to the app container, so keep only these keys in it.

# Claude API key for the app's model (claude-haiku-5-5). Empty = the app answers with fixed rules, no paid calls.
ANTHROPIC_API_KEY=

# Release switch read by compose for the Traefik router on wnyc-ingress. Keep false until the security checks
# in DEPLOY.md pass and the key works; true exposes wnyc.shiftuia.com through Traefik.
WNYC_PUBLIC=false
